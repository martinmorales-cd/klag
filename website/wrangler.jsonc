{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klag",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request goes through the Worker: it serves /mcp, rewrites /sitemap.xml,
    // negotiates markdown, and adds the agent-discovery Link headers. Static assets
    // still come from the asset server via the ASSETS binding.
    "run_worker_first": true
  }
}
