{
  "name": "klag-website",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "klag.dev — docs and promotional site for Klag, the Kafka consumer lag exporter.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
