  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "undici": "^7.28.0",
    "ws": "^8.20.1",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0",
    "gray-matter": {
      "js-yaml": "3.15.0"
    },
    "postcss": "^8.5.23",
